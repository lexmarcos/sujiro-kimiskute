DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
BOT_LANGUAGE=pt-BR

#Optional
BOT_ACTIVITY_TYPE=listening
BOT_ACTIVITY_MESSAGE="The Smiths"
BOT_ACTIVITY_CURRENT_TRACK=false

YT_DLP_PATH=yt-dlp
# Extra yt-dlp flags (shell-style quoting). The bot always adds
# "youtube:skip=hls,dash" to your youtube extractor args; keep every youtube
# setting in ONE --extractor-args value, since yt-dlp only keeps the last one.
# Low-power hosts (Raspberry Pi, 1-2 vCPU VPS, Android) can also skip the
# watch page download; remove player_skip if you use PO tokens with web clients:
# YT_DLP_EXTRA_ARGS=--extractor-args youtube:player_skip=webpage,configs
YT_DLP_EXTRA_ARGS=
# YouTube's JS challenge takes ~2 CPU seconds on a desktop and 10x that on a
# low-end ARM board. Raise to 60 on such hosts.
YT_DLP_TIMEOUT_SECONDS=45
AUTO_LEAVE_SECONDS=120
IDLE_LEAVE_SECONDS=300
PLAYER_PANEL_UPDATE_SECONDS=5
MAX_QUEUE_SIZE=50
# Each yt-dlp run can peak near 300 MB with a JS runtime. Use 1 on hosts with
# 1 vCPU or <= 1 GB RAM; the next track is prefetched while the current plays.
MAX_CONCURRENT_RESOLUTIONS=2
RUST_LOG=info
